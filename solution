class Solution {

    public int kthSmallest(TreeNode root, int k) {

        Stack <TreeNode> st = new Stack<>();

        while(true){

            while(root != null){

                st.push(root);

                root = root.left;

            }

            root = st.pop();

            k--;

            if(k == 0) return root.val;

            root = root.right;

        }

    }

}
// Time Complexity :O(logn)
// Space Complexity :O(logn) 
